# Environment Configuration
# Copy this file to .env and update with your actual values

# Database Configuration
# DB_HOST: use "postgres" (the service name) when running via docker compose.
#          Use "127.0.0.1" etc. when running ./abrdb directly on the host.
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=abrdb
DB_SSLMODE=disable

# API Configuration (uses Digital Agency's public API)
ABRDB_FEED_URL=https://dataset.address-br.digital.go.jp/api/feed/dcat-us/1.1.json

# Download Configuration
ABRDB_DOWNLOAD_DIR=/tmp/abrdb/data

# LOG_LEVEL: DEBUG|INFO|WARN|ERROR (default: INFO, case-insensitive)
# LOG_LEVEL=INFO

# Init Command Configuration
# ABRDB_PREF: Prefecture code ('all' or 1-47)
# ABRDB_PREF=all
# ABRDB_CATEGORY: Data category (basic, rsdtdsp, parcel, all)
# ABRDB_CATEGORY=basic
# ABRDB_POS: Enable position data (true/false)
# ABRDB_POS=false