{
  "compilerOptions": {
    "outDir": "./build",
    "lib": [
      "es2023"
    ],
    "target": "es2022",
    "module": "NodeNext",
    "strict": true,
    // proj4 の型定義は optional peer の geotiff を参照する。geotiff を使わないので
    // 依存の .d.ts は型検査の対象から外す。
    "skipLibCheck": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "typeRoots": [
      "./node_modules/@types"
    ],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "types": [
      "node"
    ],
    "resolveJsonModule": true,
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "paths": {
      "@domain/*": [
        "src/domain/*"
      ],
      "@interface/*": [
        "src/interface/*"
      ],
      "@drivers/*": [
        "src/drivers/*"
      ],
      "@usecases/*": [
        "src/usecases/*"
      ],
      "@config/*": [
        "src/config/*"
      ],
      "@mock/*": [
        "__mocks__/*"
      ]
    },
    "removeComments": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "plugins": [
      {
        "transform": "typescript-transform-paths"
      },
      {
        "transform": "typescript-transform-paths",
        "afterDeclarations": true
      }
    ]
  },
  "ts-node": {
    "transpileOnly": true,
    "require": [
      "typescript-transform-paths/register"
    ]
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/__skips__/",
    "**/__skip__/"
  ]
}