# Copy to .env and set DB_PASSWORD.

# Database. DB_HOST is the compose service name; DB_PORT is the host port the
# database is published on, so change it if 5432 is already in use.
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=abrdb
DB_SSLMODE=disable

# abrdb init defaults. Flags on the command line take priority.
#   ABRDB_PREF: all, or a prefecture code 1-47
#   ABRDB_CATEGORY: basic, rsdtdsp, parcel, all
#   ABRDB_POS: include coordinates
ABRDB_PREF=all
ABRDB_CATEGORY=basic
ABRDB_POS=false

# abrg server. PORT is the host port the API is published on.
PORT=3000
GIN_MODE=release
CORS_ALLOW_ORIGIN=*

# DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO
