# Environment Configuration
# Copy this file to .env and update with your actual values

# Server Configuration
PORT=3000
GIN_MODE=release
# CACHE_PATH=~/.abrg/cache/abrg.duckdb

# Database Configuration (ABR DB Tools defaults)
# DB_HOST: use "postgres" (the service name) when running via docker compose.
#          Use "127.0.0.1" etc. when running ./abrg directly on the host.
#          Must match the value used by abrdb.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=abrdb
DB_USER=postgres
DB_PASSWORD=
DB_SSLMODE=disable

# CORS (default: allow all origins)
# CORS_ALLOW_ORIGIN=https://example.com

# LOG_LEVEL: DEBUG|INFO|WARN|ERROR (default: INFO, case-insensitive)
# LOG_LEVEL=INFO
# LOG_FORMAT: json|text (default: auto-detect based on terminal)
# LOG_FORMAT=json