# Environment Configuration
# Copy this file to .env and update with your actual values

# Server Configuration
PORT=3000
GIN_MODE=release
# CACHE_PATH=~/.abrg/cache/abrg.duckdb

# Database Configuration (ABR DB Tools defaults)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=abrdb
DB_USER=postgres
DB_PASSWORD=
DB_SSLMODE=prefer

# CORS (default: allow all origins)
# CORS_ALLOW_ORIGIN=https://example.com

# LOG_LEVEL: DEBUG|INFO|WARN|ERROR (default: INFO, case-insensitive)
# LOG_LEVEL=INFO
# LOG_FORMAT: json|text (default: auto-detect based on terminal)
# LOG_FORMAT=json